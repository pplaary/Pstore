<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.adbkb">

    <application
        android:label="ADB Input Helper"
        android:allowBackup="true">

        <!-- IME Service -->
        <service
            android:name=".AdbInputMethod"
            android:label="ADB Input Helper"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.inputmethodservice"
                android:resource="@xml/method" />
        </service>

        <!-- Broadcast Receiver for text input -->
        <receiver
            android:name=".AdbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ADB_INPUT_TEXT" />
                <action android:name="ADB_INPUT_CODE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
